# Variables que Vite hornea en el build de PRODUCCIÓN (vite build).
# Las VITE_* terminan en el bundle del cliente, así que NO poner secretos acá.
VITE_API_URL=https://api.thesagle.com

# AdSense: dejar VITE_NODE_ENV fuera (o != production) mantiene los anuncios
# APAGADOS. El slot actual es un placeholder ("XXXXXXXXXX"), así que activarlo
# mostraría cajas vacías. Cuando tengas un slot real de AdSense, poné:
#   VITE_NODE_ENV=production
# (y reemplazá el slot en src/SagleApp.tsx) para encender los banners.
